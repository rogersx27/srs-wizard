generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  ESSENTIAL
  CONDITIONAL
  OPTIONAL
}

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  clientName  String
  status      ProjectStatus @default(NOT_STARTED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  completedAt DateTime?

  answers  Answer[]
  aiCaches AiCache[]

  @@index([status])
}

model Answer {
  id         String    @id @default(cuid())
  projectId  String
  questionId String
  valueText  String?
  valueJson  String?
  priority   Priority?
  updatedAt  DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, questionId])
  @@index([projectId])
}

// Resultados de IA (narrativa del SRS, hallazgos de calidad) cacheados por proyecto.
// inputHash captura el contenido que generó el resultado; si cambia, se recalcula.
// Solo se escribe cuando la IA respondió con éxito -- un fallback nunca se cachea,
// para poder reintentar la próxima vez que se consulte.
model AiCache {
  id        String   @id @default(cuid())
  projectId String
  kind      String
  inputHash String
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind])
  @@index([projectId])
}
