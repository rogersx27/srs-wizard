DATABASE_URL="file:/data/app.db"
DASHBOARD_PASSWORD="changeme"
DASHBOARD_SESSION_SECRET="replace-with-a-long-random-string"

# Opcional: redacción asistida por IA para la Introducción y Descripción General
# del SRS. Sin ninguna clave configurada, el documento usa el texto crudo del
# cliente y no falla. Soporta cuatro proveedores; si configuras más de uno,
# AI_PROVIDER decide cuál se usa (por defecto, Gemini si está configurado).
# AI_PROVIDER="gemini" # "gemini" | "anthropic" | "openai" | "gateway"

# Gemini (capa gratuita): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

# Vercel AI Gateway: https://vercel.com/ai-gateway
# Una sola clave para dos usos: AI_GATEWAY_MODEL redacta el SRS (como los demás
# proveedores) y AI_GATEWAY_EVALUATION_MODEL (Jev) detecta requisitos vagos en la
# revisión de calidad, sin importar qué AI_PROVIDER se use para la redacción.
AI_GATEWAY_API_KEY=""
AI_GATEWAY_MODEL="anthropic/claude-haiku-4.5"
AI_GATEWAY_EVALUATION_MODEL="typesafe-ai/jev"
